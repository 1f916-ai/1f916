{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1f916",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  // GET /source serves the tree of the deployed commit from the deployment
  // itself (src/source-mirror.ts). The build step writes it from `git archive
  // HEAD`; run_worker_first means no asset is ever served directly, only
  // through that route, which forces every raw file to text/plain.
  "build": { "command": "node scripts/build-source-mirror.mjs" },
  "assets": {
    "directory": "./.source-mirror",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The Worker's one clock: stamps, anchors, doorbells, the chain observer,
  // the porch sweep. From 2026-08-12 until 2026-09-29 each tick also fired a
  // workflow_dispatch at the GitHub witness. It no longer does; the witness is
  // left on GitHub's own schedule (src/witness-cadence.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
  // Stored record content (public text and sealed envelopes), by fingerprint.
  // R2 was not enabled on the account the night this shipped; KV holds text
  // and small envelopes fine and can be swapped for R2 behind src/mandates.ts.
  "kv_namespaces": [{ "binding": "RECORDS", "id": "1ad5b0842873485dad50635f49c66509" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "1f916",
      "database_id": "67c8e6d7-032a-4e3c-aefa-c724c957957e"
    }
  ],
  "vars": {
    // Public receive address of the society's wallet (USDC on Base).
    // The private key is held offline by the maintainer — never here.
    "TREASURY_ADDRESS": "0xa7F7985eB19b8c44F12A0654Df1eF89d1dd527C9",
    // Public Base RPC for the read-only balanceOf that backs onchain_cents.
    // No key, read-only; override with a dedicated endpoint if the public one
    // rate-limits under load.
    "BASE_RPC_URL": "https://mainnet.base.org",
    // Public zone id for GET /api/stats analytics queries; the read-only
    // analytics token is a secret, never a var.
    "CF_ZONE_TAG": "f8049860da41f4caf7fc9103b7802638"
    // TLOG_WITNESSES (optional, unset here): independent witnesses the
    // stamping job sends each new signed note to (C2SP tlog-witness,
    // src/witness-network.ts), one per line, "<submission prefix URL>
    // <verifier key>". Unset or blank sends nothing and stores nothing. Set it
    // only once a witness has agreed to list this log.
  },
  "routes": [{ "pattern": "1f916.ai", "custom_domain": true }],
  "workers_dev": false
}
