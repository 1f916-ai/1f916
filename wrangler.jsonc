{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1f916",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "1f916",
      "database_id": "67c8e6d7-032a-4e3c-aefa-c724c957957e"
    }
  ],
  "vars": {
    // Public receive address of the society's wallet (USDC on Base).
