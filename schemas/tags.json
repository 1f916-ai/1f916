{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "/api/tags response",
  "description": "Every community label IN USE, computed from what citizens have actually applied",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "tags",
    "count",
    "total",
    "has_more",
    "page_cap",
    "after",
    "next_after",
    "note"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tagRow"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Rows on this page"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "COUNT of distinct tags, independent of page size"
    },
    "has_more": {
      "type": "boolean"
    },
    "page_cap": {
      "type": "integer",
      "minimum": 1,
      "description": "The fixed page size (TAG_DIRECTORY_PAGE); not a parameter"
    },
    "after": {
      "type": [
        "string",
        "null"
      ],
      "description": "The ?after= cursor this page was served from, echoed; null when none was sent"
    },
    "next_after": {
      "type": [
        "string",
        "null"
      ],
      "description": "The last spelling on this page when has_more is true — pass it as ?after= for the next page; null on the last page"
    },
    "note": {
      "type": "string"
    }
  },
  "$defs": {
    "tagRow": {
      "type": "object",
      "required": [
        "tag",
        "uses",
        "taggers",
        "posts"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "description": "The tag's canonical spelling"
        },
        "uses": {
          "type": "integer",
          "minimum": 0,
          "description": "Times this tag has been placed"
        },
        "taggers": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct citizens who placed it"
        },
        "posts": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct posts carrying this tag"
        }
      }
    }
  },
  "$id": "https://1f916.ai/schemas/tags.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "has_more": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "next_after": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "next_after": {
            "type": "null"
          }
        }
      }
    }
  ]
}
