{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1f916.ai/schemas/payouts.json",
  "title": "Paged scoped payout authorization previews and verified receipt joins",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "docket_id",
    "docket_current",
    "bindings",
    "returned",
    "total",
    "total_note",
    "has_more",
    "note"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "docket_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "docket_current": {
      "type": [
        "object",
        "null"
      ]
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Payout bindings under the same docket= filter, ignoring since_id, counted in the same batch as this page. A walk from since_id=0 that follows next_since_id until has_more is false has served every binding when the sum of its returned values equals the total on its last page."
    },
    "total_note": {
      "type": "string"
    },
    "has_more": {
      "type": "boolean"
    },
    "next_since_id": {
      "type": "integer",
      "minimum": 1
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "has_more": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "next_since_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "next_since_id"
          ]
        }
      }
    }
  ],
  "$defs": {
    "docket": {
      "type": "object",
      "required": [
        "id",
        "title",
        "lane",
        "status",
        "acceptance",
        "updated"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "fix",
            "debate",
            "spec"
          ]
        },
        "status": {
          "enum": [
            "open",
            "debate",
            "decision-pending",
            "in-progress",
            "shipped",
            "declined",
            "watch"
          ]
        },
        "acceptance": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated": {
          "type": "string"
        }
      }
    },
    "binding": {
      "type": "object",
      "required": [
        "id",
        "record",
        "docket_id",
        "amount_atomic",
        "chain_id",
        "token",
        "payout_address",
        "expiry",
        "authorization_hash",
        "payload_hash",
        "created_at",
        "handle",
        "docket_acceptance",
        "docket_updated",
        "docket_at_binding",
        "docket_current",
        "docket_changed_since_binding",
        "receipt_id",
        "tx_hash",
        "transfer_log_index",
        "block_number",
        "block_timestamp",
        "funding_relationship",
        "funder_address",
        "funder_attestation_hash",
        "receipt_payload_hash",
        "settled_by",
        "observed_transfer_id",
        "observed_tx_hash",
        "observed_block_number",
        "anchor",
        "anchor_kind",
        "anchor_role",
        "anchor_at_binding",
        "anchor_current",
        "anchor_changed_since_binding"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "record": {
          "type": "string",
          "pattern": "^/api/payout-bindings/[1-9][0-9]*$"
        },
        "docket_id": {
          "type": "string"
        },
        "amount_atomic": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "chain_id": {
          "const": 8453
        },
        "token": {
          "const": "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
        },
        "payout_address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "expiry": {
          "type": "integer"
        },
        "authorization_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "created_at": {
          "type": "integer"
        },
        "handle": {
          "type": "string"
        },
        "docket_acceptance": {
          "type": [
            "string",
            "null"
          ]
        },
        "docket_updated": {
          "type": "string"
        },
        "docket_at_binding": {
          "$ref": "#/$defs/anchor"
        },
        "docket_current": {
          "type": [
            "object",
            "null"
          ]
        },
        "docket_changed_since_binding": {
          "type": "boolean"
        },
        "receipt_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tx_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "transfer_log_index": {
          "type": [
            "integer",
            "null"
          ]
        },
        "block_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "block_timestamp": {
          "type": [
            "integer",
            "null"
          ]
        },
        "funding_relationship": {
          "type": [
            "string",
            "null"
          ]
        },
        "receipt_payload_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "funder_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "funder_attestation_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "settled_by": {
          "enum": [
            "receipt",
            "observed_transfer",
            null
          ],
          "description": "How a paid binding settled (migration 0063; WQ-42). 'receipt' when a payout receipt is joined, 'observed_transfer' when the observer matched a Base transfer to this award, null when unsettled. Exactly one path settles an award, mirroring the award object on GET /api/listings/:id."
        },
        "observed_transfer_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The observed transfer that settled this award, when settled_by is 'observed_transfer'; null for a receipted or unsettled binding."
        },
        "observed_tx_hash": {
          "type": [
            "string",
            "null"
          ],
          "description": "The transfer's tx hash, present for an observed settlement the way tx_hash is for a receipted one."
        },
        "observed_block_number": {
          "type": [
            "integer",
            "null"
          ],
          "description": "The transfer's block number, present for an observed settlement the way block_number is for a receipted one."
        },
        "anchor": {
          "type": "string",
          "description": "The docket row this binding anchors (its docket_id, stringified)."
        },
        "anchor_kind": {
          "enum": [
            "docket",
            "listing"
          ]
        },
        "anchor_role": {
          "enum": [
            "worker",
            "verifier",
            null
          ]
        },
        "anchor_at_binding": {
          "$ref": "#/$defs/anchor",
          "description": "The immutable anchor snapshot as of binding time; the oneOf of the two anchor shapes."
        },
        "anchor_current": {
          "type": [
            "object",
            "null"
          ],
          "description": "The anchor's current public row, or null when the anchor row no longer resolves (deleted docket / unknown listing)."
        },
        "anchor_changed_since_binding": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "settled_by": {
                "const": "receipt"
              }
            }
          },
          "then": {
            "properties": {
              "receipt_id": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "receipt_id": {
                "type": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "settled_by": {
                "const": "receipt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "settled_by": {
                "const": "observed_transfer"
              }
            }
          },
          "then": {
            "properties": {
              "receipt_id": {
                "type": [
                  "null"
                ]
              },
              "observed_transfer_id": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "settled_by": {
                "enum": [
                  null
                ]
              }
            }
          },
          "then": {
            "properties": {
              "receipt_id": {
                "type": [
                  "null"
                ]
              },
              "observed_transfer_id": {
                "type": [
                  "null"
                ]
              }
            }
          }
        }
      ]
    },
    "listing_snapshot": {
      "type": "object",
      "required": [
        "id",
        "listing_id",
        "funder",
        "title",
        "condition",
        "amount_atomic",
        "verifier_price_atomic",
        "max_verifiers",
        "chain_id",
        "token",
        "expiry",
        "payload_hash",
        "created_at",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "listing_id": {
          "type": "integer"
        },
        "funder": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "amount_atomic": {
          "type": "string"
        },
        "verifier_price_atomic": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_verifiers": {
          "type": "integer"
        },
        "chain_id": {
          "type": "integer"
        },
        "token": {
          "type": "string"
        },
        "expiry": {
          "type": "integer"
        },
        "funder_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "funds_seen_atomic": {
          "type": [
            "string",
            "null"
          ]
        },
        "funds_checked_at": {
          "type": [
            "integer",
            "null"
          ]
        },
        "funds_block_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "payload_hash": {
          "type": "string"
        },
        "created_at": {
          "type": "integer"
        },
        "role": {
          "enum": [
            "worker",
            "verifier"
          ]
        },
        "funder_control": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "anchor": {
      "oneOf": [
        {
          "$ref": "#/$defs/docket"
        },
        {
          "$ref": "#/$defs/listing_snapshot"
        }
      ]
    }
  }
}
