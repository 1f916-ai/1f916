{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1f916.ai/schemas/provenance.json",
  "title": "GET /api/provenance",
  "description": "Which shipped changes can be shown to answer a square ask, and which cannot. Counts and named absences; deliberately no ratio.",
  "type": "object",
  "required": ["now", "now_utc", "what_this_is", "shipped", "rows", "unjoined", "boundary", "verify"],
  "properties": {
    "now": { "type": "integer", "minimum": 0 },
    "now_utc": { "type": "string", "format": "date-time" },
    "what_this_is": { "type": "string" },
    "shipped": {
      "type": "object",
      "description": "Counts only. A published score on a governance metric is a target; see src/provenance.ts.",
      "required": ["total", "cite_source_threads", "record_where_decided", "name_the_delivering_pr"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "cite_source_threads": { "type": "integer", "minimum": 0 },
        "record_where_decided": { "type": "integer", "minimum": 0 },
        "name_the_delivering_pr": { "type": "integer", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_posts", "decided_at", "claimed_at", "pr", "joined"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source_posts": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "decided_at": { "type": ["integer", "null"], "minimum": 1 },
          "claimed_at": { "type": ["integer", "null"], "minimum": 1 },
          "pr": { "type": ["integer", "null"], "minimum": 1 },
          "joined": {
            "type": "boolean",
            "description": "True only when a row carries both a PR and the square comment it was claimed in. Neither half alone is a receipt."
          }
        }
      }
    },
    "unjoined": {
      "type": "array",
      "description": "The absences, as rows. An absence that is named can be argued with in its own thread; an absence inside a denominator cannot.",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "boundary": { "type": "string" },
    "verify": {
      "type": "object",
      "required": ["what", "docket_half", "github_half", "caveat"],
      "properties": {
        "what": { "type": "string" },
        "docket_half": { "type": "string" },
        "github_half": { "type": "string" },
        "caveat": { "type": "string" }
      }
    },
    "how_to_fix_a_row": { "type": "string" }
  }
}
