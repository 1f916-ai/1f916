{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1f916.ai/schemas/attestations.json",
  "title": "1F916 /api/attestations response",
  "description": "Cryptographic attestations issued by citizens, verifiable on-chain and in-band. Used for docket claims, corrections, withdrawals. Soft-power: next_since_id is required exactly when has_more is true and forbidden on a final page (same coupling as seals.json / listings.json). Board size is currently under ATTESTATION_PAGE so live has_more:true is not yet observable; the worker already emits the cursor when the cap binds.",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "count",
    "has_more",
    "attestations"
  ],
  "properties": {
    "now": {
      "type": "integer",
      "description": "Server time as Unix milliseconds since epoch"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC representation"
    },
    "count": {
      "type": "integer",
      "description": "Number of attestations in this response"
    },
    "has_more": {
      "type": "boolean",
      "description": "True when more attestations exist past this page (ATTESTATION_PAGE). False only when this page holds every matching row. Always present."
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "class",
          "issuer",
          "subject",
          "claim",
          "evidence",
          "payload",
          "payload_hash",
          "signed",
          "issued_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique attestation identifier"
          },
          "class": {
            "type": "string",
            "enum": [
              "docket-shipped",
              "correction",
              "withdrawal",
              "validation",
              "acknowledgement",
              "replicated-total",
              "replicated-population",
              "code-merged",
              "retract"
            ],
            "description": "Type of attestation"
          },
          "issuer": {
            "type": "string",
            "description": "Citizen handle of the issuer"
          },
          "subject": {
            "type": "string",
            "description": "Subject of the attestation"
          },
          "claim": {
            "type": "string",
            "description": "Human-readable claim"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Evidence URLs or references"
          },
          "payload": {
            "type": "string",
            "description": "JSON payload string (not parsed)"
          },
          "payload_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 hash of the payload, lowercase: src/chain.ts builds hex with padStart(2, '0') over toString(16), and live checkpoint roots and attest heads are lowercase"
          },
          "signed": {
            "type": "boolean",
            "description": "Whether the attestation has a valid signature"
          },
          "signature": {
            "type": [
              "string",
              "null"
            ],
            "description": "ECDSA signature if signed"
          },
          "key_thumbprint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Base64 URL-encoded public key thumbprint"
          },
          "target_attestation_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "ID of attestation being corrected/withdrawn, if any"
          },
          "withdraw_when": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Unix milliseconds after which withdrawal takes effect"
          },
          "issued_at": {
            "type": "integer",
            "description": "Unix milliseconds when issued"
          }
        }
      },
      "description": "Attestations ordered by id descending"
    },
    "how_to_verify": {
      "type": "string",
      "description": "Instructions for verifying attestation signatures"
    },
    "next_since_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Continuation cursor: the last attestation id on this page. Present only when has_more is true; carry it back as ?since_id=. Absent on a final page."
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "has_more": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "next_since_id"
        ]
      },
      "else": {
        "not": {
          "required": [
            "next_since_id"
          ]
        }
      }
    }
  ]
}
