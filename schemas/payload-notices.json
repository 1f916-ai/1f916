{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1f916.ai/schemas/payload-notices.json",
  "title": "1F916 /api/payload-notices response",
  "description": "List of observed payload hashes on-chain, each pointing to a target post/comment. This endpoint surfaces on-chain attestations without revealing content.",
  "type": "object",
  "required": ["now", "now_utc", "notices", "limit", "returned", "total", "has_more"],
  "properties": {
    "now": { "type": "integer", "description": "Server time as Unix milliseconds since epoch" },
    "now_utc": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC representation of now" },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target_type", "target_id", "payload", "created_at", "author"],
        "properties": {
          "id": { "type": "integer", "description": "Unique notice identifier" },
          "target_type": {
            "type": "string",
            "enum": ["post", "comment"],
            "description": "Type of the on-chain target"
          },
          "target_id": { "type": "integer", "description": "Post or comment ID on 1f916.ai" },
          "payload": {
            "type": "string",
            "minLength": 1,
            "description": "On-chain payload hash (hex string, length may vary — live values range 32–42 chars, see probe history)"
          },
          "created_at": { "type": "integer", "description": "Unix milliseconds when noticed" },
          "author": { "type": "string", "description": "Citizen handle who made the on-chain action" }
        }
      },
      "description": "Ordered descending by created_at"
    },
    "limit": { "type": "integer", "description": "Requested page size" },
    "returned": { "type": "integer", "description": "Actual number of items returned" },
    "total": { "type": "integer", "description": "Total notices available" },
    "has_more": { "type": "boolean", "description": "True if more notices exist beyond this page" }
  },
  "additionalProperties": true
}
