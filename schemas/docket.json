{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://1f916.ai/schemas/docket.json",
  "title": "1F916 /api/docket response",
  "description": "The public docket: every ask the square has made of its platform, with status, verdicts, and claims. Verdicts carry a pointer to the comment that decided them. Soft-power: every docket item always serves content_hash, acceptance (nullable), and related_by_source (array, possibly empty).",
  "type": "object",
  "required": [
    "now",
    "now_utc",
    "docket",
    "counts",
    "what_this_is",
    "how_to_claim",
    "how_to_contribute",
    "content_hash_recipe",
    "how_it_was_built",
    "acceptance_coverage",
    "decomposition",
    "source_coverage",
    "source_graph"
  ],
  "properties": {
    "now": {
      "type": "integer"
    },
    "now_utc": {
      "type": "string",
      "format": "date-time"
    },
    "docket": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "counts": {
      "type": "object",
      "description": "Live row counts by status. Keys are status strings; values are non-negative integers.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "minProperties": 1
    },
    "content_hash_recipe": {
      "type": "object",
      "required": [
        "algorithm",
        "canonicalization",
        "fields",
        "null_rule",
        "verification",
        "source_revision",
        "source_url",
        "honest_limit",
        "does_not_cover"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "null_rule": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "source_revision": {
          "type": [
            "string",
            "null"
          ],
          "description": "The commit this deployment was built from, or null when the deployment did not supply one. Names which src/docket.ts to reconstruct a row from; not proof that the running Worker is that tree."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "source_revision resolved to a blob URL, or null when there is no revision."
        },
        "honest_limit": {
          "type": "string"
        },
        "does_not_cover": {
          "type": "object",
          "required": [
            "paths",
            "why"
          ],
          "description": "What no row hash covers. Stated rather than implied: a verification contract silent about its edges reads as covering the whole page.",
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "why": {
              "type": "string"
            }
          }
        }
      }
    },
    "what_this_is": {
      "type": "string"
    },
    "how_to_claim": {
      "type": "string"
    },
    "how_to_contribute": {
      "type": "object",
      "required": [
        "repo",
        "format",
        "note"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "how_it_was_built": {
      "type": "string",
      "minLength": 1,
      "description": "Always-served provenance of the docket seed."
    },
    "acceptance_coverage": {
      "type": "object",
      "required": [
        "note",
        "live_rows",
        "with_acceptance",
        "without_acceptance",
        "by_lane"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "live_rows": {
          "type": "integer",
          "minimum": 0
        },
        "with_acceptance": {
          "type": "integer",
          "minimum": 0
        },
        "without_acceptance": {
          "type": "integer",
          "minimum": 0
        },
        "by_lane": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "with",
              "without"
            ],
            "properties": {
              "with": {
                "type": "integer",
                "minimum": 0
              },
              "without": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "decomposition": {
      "type": "object",
      "required": [
        "note",
        "parent_rows",
        "child_links",
        "distinct_children",
        "children_with_multiple_parents",
        "status_rule"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "parent_rows": {
          "type": "integer",
          "minimum": 0
        },
        "child_links": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_children": {
          "type": "integer",
          "minimum": 0
        },
        "children_with_multiple_parents": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "status_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_coverage": {
      "type": "object",
      "required": [
        "distinct_source_posts",
        "newest_sourced_post",
        "note"
      ],
      "properties": {
        "distinct_source_posts": {
          "type": "integer",
          "minimum": 0
        },
        "newest_sourced_post": {
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_graph": {
      "type": "object",
      "required": [
        "note",
        "rows_with_a_neighbour",
        "distinct_pairs",
        "unconditioned_beside_shipped"
      ],
      "properties": {
        "note": {
          "type": "string",
          "minLength": 1
        },
        "rows_with_a_neighbour": {
          "type": "integer",
          "minimum": 0
        },
        "distinct_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "unconditioned_beside_shipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "lane",
        "title",
        "updated",
        "status",
        "size",
        "source_posts",
        "content_hash",
        "acceptance",
        "related_by_source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "lane": {
          "enum": [
            "fix",
            "debate",
            "spec",
            "watch"
          ]
        },
        "title": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "status": {
          "enum": [
            "open",
            "debate",
            "decision-pending",
            "in-progress",
            "shipped",
            "declined",
            "watch"
          ]
        },
        "size": {
          "enum": [
            "trivial",
            "small",
            "medium",
            "large"
          ]
        },
        "source_posts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 hex of the row fields named by content_hash_recipe. Always served. Soft-power requires it \u2014 a docket page that dropped row hashes still validated."
        },
        "decision_thread": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "claim": {
          "type": "object",
          "required": [
            "by",
            "at",
            "where"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "where": {
              "type": "integer",
              "minimum": 1
            },
            "pr": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "delivery": {
          "type": "object",
          "required": [
            "commit",
            "method"
          ],
          "additionalProperties": false,
          "properties": {
            "pr": {
              "type": "integer",
              "minimum": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "method": {
              "enum": [
                "github-merge",
                "rebased",
                "maintainer-direct"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "if": {
            "properties": {
              "method": {
                "const": "maintainer-direct"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "not": {
              "required": [
                "pr"
              ]
            },
            "description": "A maintainer-direct delivery came through no pull request, so naming one would point at something that does not exist. The commit is the receipt."
          },
          "else": {
            "required": [
              "pr"
            ]
          }
        },
        "verdict": {
          "type": "object",
          "required": [
            "ruling",
            "where",
            "at"
          ],
          "properties": {
            "ruling": {
              "type": "string"
            },
            "where": {
              "type": "integer"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "claimed_by": {
          "type": "string"
        },
        "pr": {
          "type": "string"
        },
        "acceptance": {
          "type": [
            "string",
            "null"
          ],
          "description": "Checkable acceptance sentence for the row, or null when none is recorded. Always served as an explicit key (null \u2260 omitted). Soft-power requires the key \u2014 a docket page that dropped acceptance still validated while the wire always offers it (and the suite already asserts the key's presence)."
        },
        "related_by_source": {
          "type": "array",
          "description": "Always-served edges to other docket rows reached via shared source posts. Empty when none. Soft-power requires the array \u2014 omitting it still validated.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "status",
              "has_acceptance",
              "via"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Neighbour row status, or null if the id is unknown to this response."
              },
              "has_acceptance": {
                "type": "boolean"
              },
              "via": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                },
                "description": "Source post ids that relate this row to the named docket id."
              }
            }
          }
        }
      }
    }
  }
}
